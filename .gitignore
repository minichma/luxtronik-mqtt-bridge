# Credentials and actual site configuration belong OUTSIDE the checkout.
.env
.env.*
!.env.example
secrets/
**/secrets/
*.secret
*.key
*.pem
*.p12
*.pfx
*.local.*
config/*
!config/*.example.toml
!config/devices/
config/devices/*
!config/devices/*.example.toml

# Private runtime data and raw controller captures
captures/
state/
logs/
*.log
*.pcap
*.pcapng

# Python tooling/build output
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.idea/
.vscode/
