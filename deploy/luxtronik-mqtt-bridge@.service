[Unit]
Description=Luxtronik MQTT bridge (%i)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=luxtronik-mqtt
Group=luxtronik-mqtt
WorkingDirectory=/opt/luxtronik-mqtt-bridge
ExecStart=/opt/luxtronik-mqtt-bridge/current/bin/python -m luxtronik_mqtt --config /etc/luxtronik-mqtt-bridge/devices/%i.toml run
LoadCredential=controller-password:/etc/luxtronik-mqtt-bridge/secrets/%i-controller-password
EnvironmentFile=-/etc/luxtronik-mqtt-bridge/secret-paths.env
StateDirectory=luxtronik-mqtt-bridge/%i
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartPreventExitStatus=2
RestartSec=10
TimeoutStopSec=15
LogRateLimitIntervalSec=60s
LogRateLimitBurst=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
