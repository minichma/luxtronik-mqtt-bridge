// Requires MQTT binding and JSONPath transformation. Edit broker or reuse an existing Bridge.
Bridge mqtt:broker:luxbroker "MQTT broker" [ host="mqtt.example.invalid", port=1883, secure=false ] {
    Thing topic heatpump "Luxtronik" [
        availabilityTopic="luxtronik/heatpump_old/availability",
        payloadAvailable="online", payloadNotAvailable="offline"
    ] {
        Channels:
            Type number : outdoor "Outside temperature" [ stateTopic="luxtronik/heatpump_old/information/temperatures/outdoortemperature", transformationPattern="JSONPATH:$.value", unit="°C" ]
            Type string : outdoorQuality "Outside reading quality" [ stateTopic="luxtronik/heatpump_old/information/temperatures/outdoortemperature", transformationPattern="JSONPATH:$.quality" ]
            Type datetime : outdoorObserved "Outside reading timestamp" [ stateTopic="luxtronik/heatpump_old/information/temperatures/outdoortemperature", transformationPattern="JSONPATH:$.observed_at" ]
            Type string : availability "Bridge availability" [ stateTopic="luxtronik/heatpump_old/availability" ]
    }
}
