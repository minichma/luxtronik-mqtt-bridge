// Retained timestamps describe observations, not periodic heartbeats.
rule "Luxtronik outside reading usability"
when
    Item Luxtronik_Outdoor received update or
    Item Luxtronik_OutdoorQuality received update or
    Item Luxtronik_Availability received update or
    System started
then
    val usable = Luxtronik_Availability.state.toString == "online" &&
        Luxtronik_OutdoorQuality.state.toString == "good" &&
        Luxtronik_Outdoor.state != NULL && Luxtronik_Outdoor.state != UNDEF
    Luxtronik_OutdoorFresh.postUpdate(if (usable) ON else OFF)
end
